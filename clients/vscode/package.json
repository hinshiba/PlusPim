{
	"name": "pluspim",
	"displayName": "PlusPim for VS Code",
	"publisher": "hinshiba",
	"description": "MIPS assembly time-travel debugger",
	"version": "0.2.0",
	"license": "MIT",
	"type": "module",
	"icon": "images/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/hinshiba/PlusPim.git"
	},
	"engines": {
		"vscode": "^1.108.0"
	},
	"categories": [
		"Debuggers"
	],
	"activationEvents": [
		"onDebug"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "PlusPim",
			"properties": {
				"pluspim.inlayHints.pseudoInstructions": {
					"type": "boolean",
					"default": true,
					"description": "Show the machine instructions that each pseudo-instruction (e.g. `la`, `li`) expands to as inlay hints while a PlusPim debug session is active."
				}
			}
		},
		"breakpoints": [
			{
				"language": "mips"
			}
		],
		"languages": [
			{
				"id": "mips",
				"extensions": [
					".asm",
					".s"
				],
				"aliases": [
					"MIPS Assembly"
				]
			}
		],
		"debuggers": [
			{
				"type": "pluspim",
				"label": "PlusPim Debugger",
				"languages": [
					"mips"
				],
				"configurationAttributes": {
					"launch": {
						"required": [
							"program"
						],
						"properties": {
							"program": {
								"type": [
									"string",
									"array"
								],
								"items": {
									"type": "string"
								},
								"description": "Path to the MIPS assembly file (string) or an array of paths. The runtime will normalize either form.",
								"default": [
									"${file}"
								]
							},
							"stopOnEntry": {
								"type": "boolean",
								"description": "Stop at the first instruction after the program is loaded. When false, the program runs until a breakpoint, an exception or the end.",
								"default": true
							},
							"forceTerminalUtf8": {
								"type": "boolean",
								"description": "Ask PlusPim to switch the terminal to UTF-8 while it runs and restore it on exit, so UTF-8 program output is not garbled. Currently effective on Windows only; has no effect on other platforms.",
								"default": true
							},
							"trace": {
								"type": "boolean",
								"description": "Enable DAP communication trace",
								"default": false
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Extra arguments (e.g. [\"--verbose\"])",
								"default": []
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "pluspim",
						"request": "launch",
						"name": "Minimal Launch",
						"program": [
							"${file}"
						]
					}
				]
			}
		]
	},
	"scripts": {
		"package:win32-x64": "bun scripts/vsix.ts win32-x64",
		"package:linux-x64": "bun scripts/vsix.ts linux-x64",
		"package:darwin-x64": "bun scripts/vsix.ts darwin-x64",
		"package:darwin-arm64": "bun scripts/vsix.ts darwin-arm64",
		"dotnet:publish:win": "bun scripts/vsix.ts --publish-only win32-x64",
		"dotnet:publish:linux": "bun scripts/vsix.ts --publish-only linux-x64",
		"dotnet:publish:mac-x64": "bun scripts/vsix.ts --publish-only darwin-x64",
		"dotnet:publish:mac-arm64": "bun scripts/vsix.ts --publish-only darwin-arm64",
		"dotnet:debug:win": "dotnet publish ../../PlusPim/PlusPim.csproj -c Debug -r win-x64 --self-contained -o ./bin/debug",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"ci": "biome ci .",
		"typecheck": "tsc -p ./ --noEmit && tsc -p scripts --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "^1.4.2",
		"@types/node": "^22",
		"@types/vscode": "^1.108.0",
		"@vscode/vsce": "^4.0.0",
		"typescript": "6"
	}
}